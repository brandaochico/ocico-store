<%# A payment confirmation broadcast refreshes this page in place (morph),
    keeping the scroll position — see MercadoPago::PaymentSynchronizer. %>
<% content_for :head, turbo_refreshes_with(method: :morph, scroll: :preserve) %>

<% refund_status = @order.refund_status %>

<div class="order-page wrapper">
  <h1 class="order-page__title font-heading my-6 text-h4 lg:text-h5">
    <%= accurate_title %><% if refund_status %> - <%= t("storefront.order.#{refund_status}") %><% elsif @order.paid? %> - <%= t("storefront.order.confirmed") %><% end %>
  </h1>

  <% if refund_status %>
    <p class="order-page__refund mb-6 rounded-lg border border-gray-mid bg-white p-4 font-body text-body-sm dark:bg-light-black">
      <%= t("storefront.order.refund_notice.#{refund_status}", amount: @order.display_refund_total) %>
      <%= t("storefront.order.refund_notice.timing") %>
    </p>
  <% end %>

  <% if order_just_completed?(@order) %>
    <p class="order-page__completed mb-6">
      <%= t('spree.thank_you_for_your_order') %>
    </p>
  <% end %>

  <fieldset class="order-page__info" id="order_summary">
    <%= render 'order_details', order: @order %>
  </fieldset>

  <div class="order-page__actions mb-6 p-6 text-end lg:text-center">
    <%= render partial: "shared/call_to_action", :locals => { :label => t('spree.back_to_store'), :url => root_path } %>

    <% unless order_just_completed?(@order) %>
      <% if spree_current_user && respond_to?(:account_path) %>
        <%= render partial: "shared/call_to_action", :locals => { :label => t('spree.my_account'), :type => 'secondary', :url => account_path } %>
      <% end %>
    <% end %>
  </div>
</div>
