<div class="payment-info">
  <div class="flex items-center gap-x-3 mb-6">
    <h3 class="order-shipments__title font-heading text-h6">
      <%= t('storefront.order.sections.payment') %>
    </h3>

    <%= link_to(
      t('spree.actions.edit'),
      checkout_state_path(:payment),
      { class: 'payment-info__edit underline text-body-md' }
    ) unless @order.completed? %>
  </div>

  <% order.payments.valid.each do |payment| %>
    <ul class="payment-info__info flex flex-col gap-y-2">
      <li class="flex items-center gap-x-3">
        <%= payment_method_icon(payment.payment_method) %>
        <span><%= payment.payment_method.name %></span>
      </li>
      <%# Method-specific details (QR code, card's last digits…), when the
          method has a partial; the name and icon are already shown above. %>
      <% if lookup_context.exists?(payment.payment_method.partial_name, ["orders/payment_info"], true) %>
        <li><%= render "orders/payment_info/#{payment.payment_method.partial_name}", payment: payment %></li>
      <% end %>
      <li>
        <strong><%= payment.display_amount %></strong>
        (<%= t(payment.state, scope: 'spree.payment_states') %>)
      </li>
    </ul>
  <% end %>
</div>
