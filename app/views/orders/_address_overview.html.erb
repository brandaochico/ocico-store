<div class="address-overview">
  <div class="flex items-center gap-x-3 mb-6">
    <h3 class="address-overview__title font-heading text-h6">
      <%= title %>
    </h3>
    
    <%= link_to(
      t('spree.actions.edit'),
      checkout_state_path(:address),
      { class: 'address-overview__edit underline text-body-md' }
    ) unless @order.completed? %>
  </div>

  <ul class="address-overview__info flex flex-col gap-y-2">
    <li><%= address.name %></li>
    <% unless address.company.blank? %>
      <li><%= address.company %></li>
    <% end %>
    <li>
      <%= [address.address1, address.street_number].compact_blank.join(", ") %>
      <% if address.address2.present? %>— <%= address.address2 %><% end %>
    </li>
    <% if address.neighborhood.present? %>
      <li><%= address.neighborhood %></li>
    <% end %>
    <li><%= [address.city, address.state_text].compact_blank.join(" - ") %></li>
    <li><%= t('spree.zip') %> <%= address.zipcode %></li>
    <li><%= address.country&.localized_name %></li>
    <% unless address.phone.blank? %>
      <li>
        <%= t('spree.phone') %>
        <%= address.phone %>
      </li>
    <% end %>
    <% unless address.alternative_phone.blank? %>
      <li>
        <%= t('spree.alternative_phone') %>
        <%= address.alternative_phone %>
      </li>
    <% end %>
  </ul>
</div>
