<%
  available_locales = current_store.available_locales.map do |locale|
    [
      I18n.t('spree.i18n.this_file_language',
      locale: locale,
      default: locale.to_s,
      fallback: false), locale
    ]
  end.sort
%>
<% if available_locales.many? %>
  <div
    class="locale-selector relative"
    data-controller="locale-selector"
    data-action="click@window->locale-selector#closeOnOutsideClick keydown.esc@window->locale-selector#close"
  >
    <button
      type="button"
      class="flex items-center justify-center w-6 h-6"
      aria-haspopup="true"
      aria-expanded="false"
      aria-controls="locale-selector-panel"
      data-locale-selector-target="button"
      data-action="locale-selector#toggle"
    >
      <span class="sr-only"><%= t('spree.i18n.language') %></span>
      <svg class="w-6 h-6 fill-black dark:fill-white">
        <use xlink:href="<%= image_path('remixicon.symbol.svg') %>#ri-translate-2"></use>
      </svg>
    </button>

    <div
      id="locale-selector-panel"
      class="locale-selector__panel hidden absolute right-0 top-9 z-30 w-60 rounded-xl bg-white p-4 shadow-lg"
      data-locale-selector-target="panel"
    >
      <%= form_tag select_locale_path do %>
        <div class="locale-selector__select-input select-input">
          <%= label_tag :switch_to_locale, "#{t('spree.i18n.language')}:" %>
          <%= select_tag(:switch_to_locale, options_for_select(available_locales, I18n.locale), data: { action: "locale-selector#submitForm", "locale-selector-target" => "selector" }) %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
