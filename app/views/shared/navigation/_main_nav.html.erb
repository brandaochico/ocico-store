<%
  # One markup for both placements: stacked inside the off-canvas mobile menu,
  # horizontal in the header bar from lg up. The dropdown panels follow the same
  # rule — they float over the bar on desktop and expand in place on mobile,
  # where there is no room to overlay and no pointer to hover with.
  #
  # All three groups are dropdowns because six country names written out
  # alongside them overflowed the bar into the search field at every width from
  # 1280px up. "Cartas Avulsas" is a plain link and closes the row, because it
  # is a single destination rather than a group.
  #
  # cursor-pointer is explicit: Tailwind's preflight leaves <button> with the
  # default arrow, so without it the three dropdown triggers felt inert next to
  # the links beside them.
  link_classes = "font-sans-md cursor-pointer hover:text-primary transition-colors duration-150"
  panel_classes = "hidden mt-2 pl-3 lg:absolute lg:left-0 lg:top-full lg:z-30 lg:mt-2 lg:min-w-60 " \
                  "lg:rounded-xl lg:bg-white lg:p-3 lg:shadow-lg lg:text-black"

  groups = [
    [ t("storefront.navigation.countries"), nav_origin_taxons, nil ],
    [ t("storefront.navigation.products"), nav_product_type_taxons, nil ],
    [ t("storefront.navigation.collections"), nav_recent_collections, collections_path ]
  ]
%>

<ul class="flex flex-col gap-y-4 lg:flex-row lg:items-center lg:gap-x-5 xl:gap-x-7"
    aria-label="<%= t('storefront.navigation.main') %>">
  <% groups.each do |label, taxons, see_all_path| %>
    <% next if taxons.empty? %>

    <li
      class="lg:relative"
      data-controller="nav-dropdown"
      data-action="mouseenter->nav-dropdown#show mouseleave->nav-dropdown#hide click@window->nav-dropdown#closeOnOutsideClick keydown.esc@window->nav-dropdown#unpinAndClose"
    >
      <button
        type="button"
        class="<%= link_classes %> flex items-center gap-x-1 whitespace-nowrap"
        aria-haspopup="true"
        aria-expanded="false"
        data-nav-dropdown-target="button"
        data-action="nav-dropdown#toggle"
      >
        <%= label %>
        <svg class="w-4 h-4 fill-current" aria-hidden="true">
          <use xlink:href="<%= image_path('remixicon.symbol.svg') %>#ri-arrow-down-s-line"></use>
        </svg>
      </button>

      <div class="<%= panel_classes %>" data-nav-dropdown-target="menu">
        <%
          entries = taxons.map { |taxon| [ taxon.name, taxon_seo_url(taxon), nil ] }
          entries << [ t("storefront.navigation.see_all_collections"), see_all_path, "italic" ] if see_all_path
        %>
        <ul class="flex flex-col gap-y-1 text-left">
          <% entries.each do |name, url, extra_classes| %>
            <li class="<%= "border-t border-gray-mid mt-1 pt-2" if extra_classes %>">
              <%# justify-between parks the chevron at the end of the row, so the
                  label stays flush left however long the two are. %>
              <%= link_to url, class: "#{link_classes} #{extra_classes} flex items-center justify-between gap-x-6 whitespace-nowrap" do %>
                <span><%= name %></span>
                <svg class="w-4 h-4 shrink-0 fill-gray-400" aria-hidden="true">
                  <use xlink:href="<%= image_path('remixicon.symbol.svg') %>#ri-arrow-right-s-line"></use>
                </svg>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    </li>
  <% end %>

  <% if nav_singles_taxon %>
    <li>
      <%= link_to nav_singles_taxon.name, taxon_seo_url(nav_singles_taxon),
            class: "#{link_classes} whitespace-nowrap" %>
    </li>
  <% end %>
</ul>
