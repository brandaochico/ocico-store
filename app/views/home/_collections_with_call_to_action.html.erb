<section class="grid-container grid-cols-1 gap-7 wrapper py-4 lg:py-12 lg:grid-cols-4">
  <div class="flex flex-col items-center justify-center py-10 px-3">
    <span class="text-h3 text-center font-heading mb-5"><%= t("storefront.home.cta_headline") %></span>
    <%= render "shared/call_to_action", { label: t("storefront.home.cta_label"), url: products_path } %>
  </div>

  <% products.each_with_index do |product, index| %>
    <%
      product_image = product.gallery.images.second || product.gallery.images.first
    %>

    <%= cache [I18n.locale, current_pricing_options, @taxon, product] do %>
      <%= link_to product_path(product) do %>
        <%# A column: the photo, whole, in the space above; the white band with
            the name and price below it — beside it, never over it, so no part of
            the photo is hidden. %>
        <div class="flex aspect-square flex-col bg-gray-50 overflow-hidden rounded-lg md:rounded-xl lg:rounded-2xl">
          <div class="relative min-h-0 flex-1">
            <%= render(ImageComponent.new(
              image: product_image,
              class: 'absolute inset-0 h-full w-full object-contain',
              size: :full,
            )) %>
          </div>
          <%# White band behind the name and price, rounded like the card's bottom
              edge, as on the featured cards. text-black has no dark: variant on
              purpose: the band stays white in both themes. %>
          <div class="flex flex-col items-start w-full gap-y-1 bg-white px-3 py-3 text-black rounded-b-lg md:px-6 md:py-4 md:flex-row md:justify-between md:items-center md:gap-y-0 md:gap-x-2 md:rounded-b-xl lg:rounded-b-2xl">
            <span class="w-full text-body-sm md:text-body">
              <%= product.name %>
            </span>
            <span class="text-body-sm md:text-body font-body price selling">
              <%= product.display_price %>
            </span>
          </div>
        </div>
      <% end %>
    <% end %>
  <% end %>
</section>
