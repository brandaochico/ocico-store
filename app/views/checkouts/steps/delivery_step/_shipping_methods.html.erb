<%
  order = form.object.order
  # Live-updates the order summary's freight and total when another rate is
  # picked (shipping_summary_controller.js). Only for a single shipment: with
  # several, one rate alone doesn't determine the total.
  live_summary = order.shipments.size == 1
  total_without_shipping = order.order_total_after_store_credit - order.ship_total
%>

<ul class="shipping-methods">
  <% shipping_rates.each do |rate| %>
    <li class="shipping-methods__rate mb-6 last:mb-0">
      <%= form.label :selected_shipping_rate_id, value: rate.id, class: "radio-input flex gap-x-3 items-center last:mb-0" do %>
        <%= form.radio_button(
          :selected_shipping_rate_id,
          rate.id,
          **(live_summary ? {
            data: {
              action: "shipping-summary#select",
              shipping_summary_shipping_param: rate.display_cost.to_s,
              shipping_summary_total_param: Spree::Money.new(total_without_shipping + rate.cost, currency: order.currency).to_s
            }
          } : {})
        ) %>
        <%= "#{rate.name} #{rate.display_cost}" %>
      <% end %>
    </li>
  <% end %>
</ul>
