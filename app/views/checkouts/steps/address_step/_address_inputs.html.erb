<%
  base_classes = 'flex flex-col gap-y-3 border-b-[1px] pb-6 border-b-gray-mid md:gap-y-6'
  classes = defined?(additional_classes) && additional_classes.present? ? "#{base_classes} #{additional_classes}" : base_classes
  brazil = Spree::Country.find_by(iso: "BR")
%>

<%# Brazilian field order: CEP first, so the lookup can fill street,
    neighbourhood, city and state before the customer gets to them. %>
<div class="address-inputs <%= classes %>"
     data-controller="address-lookup"
     data-address-lookup-brazil-id-value="<%= brazil&.id %>"
     data-address-lookup-states-value="<%= (brazil ? brazil.states.pluck(:abbr, :id).to_h : {}).to_json %>"
     data-address-lookup-not-found-value="<%= t("checkout.address.cep_not_found") %>">
  <div class="text-input">
    <%= form.label :name, "#{I18n.t("spree.name")}:" %>
    <%= form.text_field :name, required: true, autofocus: true, autocomplete: "#{address_type} name" %>
  </div>

  <% if Spree::Config[:company] %>
    <div class="text-input">
      <%= form.label :company, "#{I18n.t("spree.company")}:" %>
      <%= form.text_field :company, autocomplete: "#{address_type} organization" %>
    </div>
  <% end %>

  <div class="select-input w-full">
    <%= form.label :country_id, "#{I18n.t("spree.country")}:" %>

    <%= form.collection_select(
      :country_id,
      available_countries,
      :id,
      :name,
      {},
      autocomplete: "#{address_type} country-name",
      class: 'js-trigger-state-change w-full',
      required: true,
      "data-state-container": "##{address_type} .js-address-fields",
      "data-address-lookup-target": "country",
      "data-action": "change->address-lookup#countryChanged"
    ) %>
  </div>

  <div class="text-input md:max-w-xs">
    <%= form.label :zipcode, "#{I18n.t("spree.zip")}:" %>

    <%= form.text_field :zipcode,
      required: address.require_zipcode?,
      autocomplete: "#{address_type} postal-code",
      inputmode: "numeric",
      "data-address-lookup-target": "zipcode",
      "data-action": "input->address-lookup#zipcodeChanged"
    %>
    <p class="hidden text-body-xs text-red-600 dark:text-red-400" data-address-lookup-target="message" role="status"></p>
  </div>

  <div class="text-input">
    <%= form.label :address1, "#{I18n.t("spree.street_address")}:" %>
    <%= form.text_field :address1, required: true, autocomplete: "#{address_type} address-line1",
          "data-address-lookup-target": "street" %>
  </div>

  <div class="flex flex-col gap-3 md:gap-6 md:flex-row">
    <div class="text-input md:w-40 md:shrink-0">
      <%= form.label :street_number, "#{Spree::Address.human_attribute_name(:street_number)}:" %>
      <%= form.text_field :street_number, autocomplete: "off",
            "data-address-lookup-target": "number" %>
    </div>

    <div class="text-input w-full">
      <%= form.label :address2, "#{I18n.t("spree.street_address_2")}:" %>
      <%= form.text_field :address2, autocomplete: "#{address_type} address-line2",
            placeholder: t("checkout.address.complement_placeholder") %>
    </div>
  </div>

  <div class="text-input">
    <%= form.label :neighborhood, "#{Spree::Address.human_attribute_name(:neighborhood)}:" %>
    <%= form.text_field :neighborhood, autocomplete: "#{address_type} address-level3",
          "data-address-lookup-target": "neighborhood" %>
  </div>

  <div class="flex flex-col gap-3 md:gap-6 md:flex-row">
    <div class="text-input w-full">
      <%= form.label :city, "#{I18n.t("spree.city")}:" %>
      <%= form.text_field :city, required: true, autocomplete: "#{address_type} address-level2",
            "data-address-lookup-target": "city" %>
    </div>

    <% if Spree::Config[:address_requires_state] %>
      <% have_states = !address.country.states.empty? %>

      <span class="js-address-fields w-full" style="display: none;">
        <div class="select-input w-full">
          <%= form.label :state_id, "#{I18n.t("spree.state")}:" %>

          <%= form.collection_select(
            :state_id,
            address.country.states,
            :id,
            :name,
            { include_blank: true },
            autocomplete: "#{address_type} address-level1",
            class: 'required w-full',
            disabled: !have_states,
            required: false,
            "data-address-lookup-target": "state"
          ) %>
        </div>

        <%= form.text_field(
          :state_name,
          class: !have_states ? 'required' : '',
          style: have_states ? 'display: none;' : '',
          disabled: have_states,
          autocomplete: "#{address_type} address-level1"
        ) %>
      </span>
      <noscript>
        <%= form.text_field(
          :state_name,
          class: 'required',
          autocomplete: "#{address_type} address-level1",
          required: true
        ) %>
      </noscript>
    <% end %>
  </div>

  <div class="text-input">
    <%= form.label :phone, "#{I18n.t("spree.phone")}:" %>

    <%= form.telephone_field :phone,
      required: address.require_phone?,
      autocomplete: "#{address_type} home tel"
    %>
  </div>

  <% if Spree::Config[:alternative_shipping_phone] %>
    <div class="text-input">
      <%= form.label :alternative_phone, "#{I18n.t("spree.alternative_phone")}:" %>
      <%= form.telephone_field :alternative_phone, autocomplete: "#{address_type} tel" %>
    </div>
  <% end %>
</div>
