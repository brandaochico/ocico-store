<div class="relative flex items-center" data-controller="top-bar">
  <div class="flex items-center gap-x-4 lg:gap-x-6">
    <div class="hidden lg:flex">
      <%= render "shared/navigation/locale_selector" %>
    </div>
    <%# Full search input only fits from lg up — below that it's just an icon
        that opens the categories drawer, where the mobile search input
        already lives (rendered in shared/navigation/_header.html.erb). %>
    <%= render 'shared/search/search_bar', taxons: taxons, taxon: taxon, :locals => { :additional_classes => 'hidden lg:flex' } %>
    <button type="button" class="flex items-center justify-center w-6 h-6 lg:hidden" title="<%= t('spree.search') %>" data-action="click->drawer#toggle">
      <span class="sr-only"><%= t('spree.search') %></span>
      <svg class='w-6 h-6 fill-black dark:fill-white'>
        <use xlink:href="<%= image_path('remixicon.symbol.svg') %>#ri-search-2-line"></use>
      </svg>
    </button>
    <div class="hidden lg:flex">
      <%= render "shared/navigation/theme_switcher" %>
    </div>
    <div class='relative w-6 h-6'>
      <svg class='w-6 h-6 fill-black dark:fill-white'>
        <use xlink:href="<%= image_path('remixicon.symbol.svg') %>#ri-shopping-cart-2-line"></use>
      </svg>
      <div id="link-to-cart" class="absolute top-0 left-0 w-full h-full" data-top-bar-target="cartLink">
        <noscript>
          <%= link_to t('spree.cart'), cart_path %>
        </noscript>
      </div>
    </div>

    <div class="relative w-6 h-6">
      <%= link_to spree_current_user ? account_path : login_path, title: spree_current_user ? t('spree.account') : t('spree.login') do %>
        <svg class='w-6 h-6 fill-black dark:fill-white'>
          <use xlink:href="<%= image_path('remixicon.symbol.svg') %>#ri-user-line"></use>
        </svg>
      <% end %>
    </div>
  </div>
</div>
