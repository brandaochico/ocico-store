<div class="products wrapper mt-8 mb-20">
  <div class="mb-6">
    <%= render 'shared/search/filters', taxon: @taxon %>
  </div>
  <section class="products_section">
    <% if params[:keywords] && @products.empty? %>
      <span class="font-heading text-h6 md:text-h5 lg:text-h3">
        <%= t('spree.no_products_found') %>
      </span>
    <% else %>
      <%= render 'products', products: @products, taxon: @taxon %>
    <% end %>
  </section>
</div>
