<div class="col-span-full md:col-span-9">
  <picture class="mx-auto flex aspect-square w-full max-w-[600px] items-center justify-center overflow-hidden bg-gray-50 rounded-lg md:rounded-xl lg:rounded-2xl">
    <%= render(ImageComponent.new(
      image: product.gallery.images.first,
      size: :product,
      itemprop: "image",
      data: { js: 'product-main-image' },
      class: 'h-full w-full object-contain'
    )) %>
  </picture>
</div>
